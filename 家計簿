<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>スマート家計簿 + カスタムカテゴリ</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Sans JP', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen pb-20 md:pb-6">

    <!-- App Header -->
    <header class="bg-slate-900 text-white shadow-md sticky top-0 z-20">
        <div class="max-w-md mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <i data-lucide="wallet" class="w-6 h-6 text-emerald-400"></i>
                <h1 class="text-base font-bold tracking-wide">スマート家計簿</h1>
                <span id="gas-status-badge" class="text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-medium flex items-center gap-1 border border-slate-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span> 未連携
                </span>
            </div>
            <div class="flex items-center space-x-2">
                <!-- Month Picker -->
                <input type="month" id="month-picker" class="bg-slate-800 text-white text-xs px-2 py-1.5 rounded-lg border border-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500">
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-md mx-auto px-4 pt-4 space-y-4">

        <!-- Summary Cards -->
        <section class="grid grid-cols-3 gap-2">
            <div class="bg-white p-3 rounded-2xl shadow-sm border border-slate-200/60 flex flex-col justify-between">
                <span class="text-xs font-medium text-slate-500">収入</span>
                <span id="total-income" class="text-base font-bold text-emerald-600 mt-1">¥0</span>
            </div>
            <div class="bg-white p-3 rounded-2xl shadow-sm border border-slate-200/60 flex flex-col justify-between">
                <span class="text-xs font-medium text-slate-500">支出</span>
                <span id="total-expense" class="text-base font-bold text-rose-500 mt-1">¥0</span>
            </div>
            <div class="bg-white p-3 rounded-2xl shadow-sm border border-slate-200/60 flex flex-col justify-between">
                <span class="text-xs font-medium text-slate-500">残高</span>
                <span id="net-balance" class="text-base font-bold text-indigo-600 mt-1">¥0</span>
            </div>
        </section>

        <!-- VIEW 1: Dashboard -->
        <div id="view-dashboard" class="view-content space-y-4">
            <!-- GAS Sync Status Banner -->
            <div id="gas-sync-banner" class="hidden bg-emerald-50 border border-emerald-200 rounded-xl p-3 flex items-center justify-between text-xs text-emerald-800">
                <div class="flex items-center space-x-2">
                    <i data-lucide="sheet" class="w-4 h-4 text-emerald-600"></i>
                    <span>スプレッドシート自動書き込み有効</span>
                </div>
                <span class="text-[10px] bg-emerald-200 text-emerald-800 px-2 py-0.5 rounded-full font-bold">ON</span>
            </div>

            <!-- Expense Category Breakdown Bar Chart -->
            <section class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200/60">
                <h2 class="text-sm font-bold text-slate-700 mb-3 flex items-center justify-between">
                    <span>カテゴリ別支出内訳</span>
                    <span id="expense-month-label" class="text-xs font-normal text-slate-400">今月</span>
                </h2>
                <div id="category-bars" class="space-y-3">
                    <!-- Dynamic Bars -->
                </div>
                <div id="no-category-data" class="hidden text-center py-6 text-slate-400 text-xs">
                    この月の支出データはありません
                </div>
            </section>

            <!-- Recent Transactions Mini List -->
            <section class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200/60">
                <div class="flex justify-between items-center mb-3">
                    <h2 class="text-sm font-bold text-slate-700">最近の履歴</h2>
                    <button onclick="switchTab('history')" class="text-xs text-emerald-600 font-medium hover:underline">すべて見る</button>
                </div>
                <div id="recent-list" class="divide-y divide-slate-100">
                    <!-- Dynamic List -->
                </div>
            </section>
        </div>

        <!-- VIEW 2: Form Entry -->
        <div id="view-add" class="view-content hidden">
            <section class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/60">
                <h2 class="text-base font-bold text-slate-800 mb-4">収支を入力</h2>
                
                <form id="transaction-form" onsubmit="handleFormSubmit(event)" class="space-y-4">
                    <!-- Type Toggle -->
                    <div class="grid grid-cols-2 gap-2 p-1 bg-slate-100 rounded-xl">
                        <button type="button" id="btn-type-expense" onclick="setType('expense')" 
                            class="py-2.5 text-xs font-bold rounded-lg transition-all bg-white text-rose-500 shadow-sm">
                            支出
                        </button>
                        <button type="button" id="btn-type-income" onclick="setType('income')" 
                            class="py-2.5 text-xs font-bold rounded-lg transition-all text-slate-500">
                            収入
                        </button>
                    </div>

                    <!-- Date Input -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">日付</label>
                        <input type="date" id="input-date" required
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                    </div>

                    <!-- Category Selector & Add Option -->
                    <div>
                        <div class="flex justify-between items-center mb-1">
                            <label class="block text-xs font-semibold text-slate-600">カテゴリ</label>
                            <button type="button" onclick="openCategoryModal(currentType)" class="text-[11px] text-emerald-600 font-semibold hover:underline flex items-center gap-0.5">
                                <i data-lucide="plus" class="w-3 h-3"></i> カテゴリ追加/編集
                            </button>
                        </div>
                        <select id="input-category" required
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                        </select>
                    </div>

                    <!-- Amount Input -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">金額 (円)</label>
                        <div class="relative">
                            <span class="absolute left-3 top-2.5 text-slate-400 font-bold text-sm">¥</span>
                            <input type="number" id="input-amount" min="1" placeholder="0" required
                                class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-8 pr-3 py-2.5 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-emerald-500">
                        </div>
                    </div>

                    <!-- Note Input -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">メモ (任意)</label>
                        <input type="text" id="input-note" placeholder="例：スーパーで買い物"
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" id="submit-btn"
                        class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl shadow-md active:scale-[0.98] transition-all text-sm mt-2 flex items-center justify-center space-x-1.5">
                        <i data-lucide="check" class="w-4 h-4"></i>
                        <span>記録を保存</span>
                    </button>
                </form>
            </section>
        </div>

        <!-- VIEW 3: Detailed History -->
        <div id="view-history" class="view-content hidden space-y-3">
            <!-- Filter Bar -->
            <div class="bg-white p-3 rounded-2xl shadow-sm border border-slate-200/60 flex gap-2">
                <select id="history-filter-category" onchange="renderHistory()" 
                    class="bg-slate-50 border border-slate-200 text-xs rounded-lg px-2.5 py-2 flex-1 focus:outline-none">
                    <option value="all">すべてのカテゴリ</option>
                </select>
                <select id="history-filter-type" onchange="renderHistory()" 
                    class="bg-slate-50 border border-slate-200 text-xs rounded-lg px-2.5 py-2 focus:outline-none">
                    <option value="all">すべて</option>
                    <option value="expense">支出のみ</option>
                    <option value="income">収入のみ</option>
                </select>
            </div>

            <!-- Transaction History List -->
            <section class="bg-white rounded-2xl shadow-sm border border-slate-200/60 overflow-hidden">
                <div id="full-history-list" class="divide-y divide-slate-100 max-h-[60vh] overflow-y-auto custom-scrollbar">
                    <!-- Dynamic rendering -->
                </div>
            </section>
        </div>

        <!-- VIEW 4: Settings & Category Management -->
        <div id="view-settings" class="view-content hidden space-y-4">
            
            <!-- Category Management Card -->
            <section class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/60 space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-2">
                        <div class="w-8 h-8 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center">
                            <i data-lucide="tags" class="w-4 h-4"></i>
                        </div>
                        <div>
                            <h2 class="text-sm font-bold text-slate-800">カテゴリ設定・管理</h2>
                            <p class="text-[11px] text-slate-400">アイコン・カラー・名前の編集</p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-2 pt-1">
                    <button onclick="openCategoryModal('expense')" 
                        class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2.5 rounded-xl text-xs flex items-center justify-center space-x-1.5 transition-colors">
                        <i data-lucide="edit-3" class="w-3.5 h-3.5 text-rose-500"></i>
                        <span>支出カテゴリ編集</span>
                    </button>
                    <button onclick="openCategoryModal('income')" 
                        class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2.5 rounded-xl text-xs flex items-center justify-center space-x-1.5 transition-colors">
                        <i data-lucide="edit-3" class="w-3.5 h-3.5 text-emerald-600"></i>
                        <span>収入カテゴリ編集</span>
                    </button>
                </div>
            </section>

            <!-- GAS Integration Card -->
            <section class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/60 space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-2">
                        <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center">
                            <i data-lucide="sheet" class="w-4 h-4"></i>
                        </div>
                        <div>
                            <h2 class="text-sm font-bold text-slate-800">Google スプレッドシート連携</h2>
                            <p class="text-[11px] text-slate-400">GAS Web Appで自動データ追記</p>
                        </div>
                    </div>
                    <!-- Toggle Switch -->
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="gas-toggle" onchange="toggleGasIntegration()" class="sr-only peer">
                        <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600"></div>
                    </label>
                </div>

                <div class="space-y-3 pt-1">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Web App URL (GAS)</label>
                        <input type="url" id="gas-url-input" placeholder="https://script.google.com/macros/s/.../exec"
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500">
                    </div>
                    <div class="flex gap-2">
                        <button onclick="saveGasSettings()" 
                            class="flex-1 bg-slate-800 hover:bg-slate-900 text-white font-bold py-2 rounded-xl text-xs transition-colors">
                            URL設定を保存
                        </button>
                        <button onclick="openGasGuideModal()" 
                            class="bg-indigo-50 text-indigo-600 hover:bg-indigo-100 font-semibold px-3 py-2 rounded-xl text-xs transition-colors flex items-center space-x-1">
                            <i data-lucide="help-circle" class="w-3.5 h-3.5"></i>
                            <span>ガイド</span>
                        </button>
                    </div>
                </div>
            </section>

            <!-- Local Data Management -->
            <section class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/60 space-y-3">
                <h2 class="text-sm font-bold text-slate-800">データ・設定リセット</h2>
                <div class="space-y-2">
                    <button onclick="resetCategoriesToDefault()" 
                        class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2.5 rounded-xl text-xs flex items-center justify-center space-x-2 transition-colors">
                        <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                        <span>カテゴリを初期設定に戻す</span>
                    </button>
                    <button onclick="clearAllData()" 
                        class="w-full bg-rose-50 hover:bg-rose-100 text-rose-600 font-semibold py-2.5 rounded-xl text-xs flex items-center justify-center space-x-2 transition-colors">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                        <span>すべてのローカルデータを初期化</span>
                    </button>
                </div>
            </section>
        </div>

    </main>

    <!-- MODAL 1: Category Management Modal -->
    <div id="category-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl shadow-xl max-w-md w-full max-h-[85vh] flex flex-col overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <div class="flex items-center space-x-2">
                    <i data-lucide="tag" class="w-5 h-5 text-indigo-600"></i>
                    <h3 id="category-modal-title" class="font-bold text-slate-800 text-sm">カテゴリ設定</h3>
                </div>
                <button onclick="closeCategoryModal()" class="text-slate-400 hover:text-slate-600">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            
            <div class="p-4 overflow-y-auto custom-scrollbar space-y-4">
                <!-- Add New Category Form Trigger -->
                <div class="p-3 bg-indigo-50/60 border border-indigo-100 rounded-xl space-y-3">
                    <p class="text-xs font-bold text-indigo-900" id="cat-form-title">新しいカテゴリを追加</p>
                    <input type="hidden" id="edit-cat-id" value="">
                    <div class="flex gap-2">
                        <!-- Icon Input (Emoji) -->
                        <input type="text" id="cat-emoji-input" placeholder="アイコン(絵文字)" maxlength="2" value="🏷️"
                            class="w-14 bg-white border border-slate-200 rounded-xl text-center py-2 text-base focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <!-- Name Input -->
                        <input type="text" id="cat-name-input" placeholder="カテゴリ名（例：カフェ）"
                            class="flex-1 bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <!-- Color Picker Palette -->
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-500 mb-1">カラー選択</label>
                        <div id="color-palette" class="flex flex-wrap gap-2">
                            <!-- Injected Colors -->
                        </div>
                    </div>
                    <div class="flex gap-2 pt-1">
                        <button onclick="saveCategory()" id="btn-save-cat"
                            class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 rounded-xl text-xs transition-colors shadow-sm">
                            保存する
                        </button>
                        <button onclick="cancelCategoryEdit()" id="btn-cancel-cat" class="hidden bg-slate-200 text-slate-600 font-bold px-3 py-2 rounded-xl text-xs">
                            キャンセル
                        </button>
                    </div>
                </div>

                <!-- Category List Section -->
                <div>
                    <h4 class="text-xs font-bold text-slate-500 mb-2">登録済みカテゴリ一覧</h4>
                    <div id="category-manage-list" class="space-y-2">
                        <!-- Dynamic List -->
                    </div>
                </div>
            </div>

            <div class="p-3 border-t border-slate-100 bg-slate-50 text-right">
                <button onclick="closeCategoryModal()" class="bg-slate-800 text-white px-4 py-2 rounded-xl text-xs font-bold">
                    完了
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL 2: GAS Setup Guide Modal -->
    <div id="gas-guide-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl shadow-xl max-w-md w-full max-h-[85vh] flex flex-col overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <div class="flex items-center space-x-2">
                    <i data-lucide="file-code" class="w-5 h-5 text-emerald-600"></i>
                    <h3 class="font-bold text-slate-800 text-sm">スプレッドシート連携ガイド</h3>
                </div>
                <button onclick="closeGasGuideModal()" class="text-slate-400 hover:text-slate-600">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            
            <div class="p-4 overflow-y-auto custom-scrollbar space-y-4 text-xs text-slate-600">
                <p>Googleスプレッドシートに家計簿データを自動送信するための手順です。</p>
                
                <ol class="list-decimal list-inside space-y-2 font-medium text-slate-700">
                    <li>新しいGoogleスプレッドシートを作成します。</li>
                    <li>メニューの <strong>「拡張機能」&gt;「Apps Script」</strong> を開きます。</li>
                    <li>以下のスクリプトコードをコピーして貼り付けます。</li>
                </ol>

                <!-- GAS Code Block -->
                <div class="relative bg-slate-900 text-slate-200 p-3 rounded-xl font-mono text-[11px] overflow-x-auto">
                    <button onclick="copyGasCode()" class="absolute top-2 right-2 bg-slate-700 hover:bg-slate-600 text-white text-[10px] px-2 py-1 rounded">
                        コピー
                    </button>
                    <pre id="gas-code-text">function doPost(e) {
  try {
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    var data = JSON.parse(e.postData.contents);
    
    if (sheet.getLastRow() === 0) {
      sheet.appendRow(["ID", "日付", "区分", "カテゴリ", "金額", "メモ"]);
    }
    
    sheet.appendRow([
      data.id || "",
      data.date || "",
      data.type === "expense" ? "支出" : "収入",
      data.categoryName || "",
      data.amount || 0,
      data.note || ""
    ]);
    
    return ContentService.createTextOutput(JSON.stringify({result: "success"}))
      .setMimeType(ContentService.MimeType.JSON);
  } catch (error) {
    return ContentService.createTextOutput(JSON.stringify({result: "error", message: error.toString()}))
      .setMimeType(ContentService.MimeType.JSON);
  }
}</pre>
                </div>

                <ol start="4" class="list-decimal list-inside space-y-2 font-medium text-slate-700">
                    <li>右上の <strong>「デプロイ」&gt;「新しいデプロイ」</strong> をクリック。</li>
                    <li>種類で <strong>「ウェブアプリ」</strong> を選択。</li>
                    <li>アクセスできるユーザーを <strong>「全員 (Anyone)」</strong> に設定してデプロイ。</li>
                    <li>発行された Web App URL をコピーし、アプリの設定に入力してください。</li>
                </ol>
            </div>

            <div class="p-3 border-t border-slate-100 bg-slate-50 text-right">
                <button onclick="closeGasGuideModal()" class="bg-slate-800 text-white px-4 py-2 rounded-xl text-xs font-bold">
                    閉じる
                </button>
            </div>
        </div>
    </div>

    <!-- Notification Toast -->
    <div id="toast" class="fixed bottom-20 left-1/2 -translate-x-1/2 bg-slate-800 text-white text-xs px-4 py-2.5 rounded-full shadow-lg opacity-0 pointer-events-none transition-all duration-300 z-50 flex items-center space-x-2">
        <i id="toast-icon" data-lucide="info" class="w-4 h-4 text-emerald-400"></i>
        <span id="toast-message">メッセージ</span>
    </div>

    <!-- Bottom Navigation Bar -->
    <nav class="fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200/80 z-30">
        <div class="max-w-md mx-auto grid grid-cols-4 h-16">
            <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn flex flex-col items-center justify-center text-emerald-600">
                <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                <span class="text-[10px] mt-1 font-medium">ダッシュボード</span>
            </button>
            <button onclick="switchTab('add')" id="nav-add" class="nav-btn flex flex-col items-center justify-center text-slate-400">
                <i data-lucide="plus-circle" class="w-5 h-5"></i>
                <span class="text-[10px] mt-1 font-medium">入力</span>
            </button>
            <button onclick="switchTab('history')" id="nav-history" class="nav-btn flex flex-col items-center justify-center text-slate-400">
                <i data-lucide="list-ordered" class="w-5 h-5"></i>
                <span class="text-[10px] mt-1 font-medium">履歴</span>
            </button>
            <button onclick="switchTab('settings')" id="nav-settings" class="nav-btn flex flex-col items-center justify-center text-slate-400">
                <i data-lucide="settings" class="w-5 h-5"></i>
                <span class="text-[10px] mt-1 font-medium">設定</span>
            </button>
        </div>
    </nav>

    <!-- JavaScript Application Logic -->
    <script>
        // Preset Colors Palette
        const COLOR_PALETTE = [
            'bg-amber-500', 'bg-emerald-500', 'bg-blue-500', 'bg-rose-500',
            'bg-purple-500', 'bg-pink-500', 'bg-indigo-500', 'bg-cyan-500',
            'bg-orange-500', 'bg-teal-500', 'bg-slate-500'
        ];

        // Default Initial Categories Setup
        const DEFAULT_CATEGORIES = {
            expense: [
                { id: 'food', name: '食費', emoji: '🍱', color: 'bg-amber-500' },
                { id: 'daily', name: '日用品', emoji: '🛒', color: 'bg-emerald-500' },
                { id: 'transport', name: '交通費', emoji: '🚌', color: 'bg-blue-500' },
                { id: 'entertainment', name: '交際・娯楽', emoji: '🎉', color: 'bg-pink-500' },
                { id: 'housing', name: '固定費・住居', emoji: '🏠', color: 'bg-purple-500' },
                { id: 'other_exp', name: 'その他支出', emoji: '💡', color: 'bg-slate-500' }
            ],
            income: [
                { id: 'salary', name: '給与', emoji: '💰', color: 'bg-emerald-500' },
                { id: 'side', name: '副業', emoji: '💻', color: 'bg-cyan-500' },
                { id: 'bonus', name: '臨時収入', emoji: '🎁', color: 'bg-indigo-500' },
                { id: 'other_inc', name: 'その他収入', emoji: '✨', color: 'bg-slate-500' }
            ]
        };

        // App States
        let categories = JSON.parse(JSON.stringify(DEFAULT_CATEGORIES));
        let transactions = [];
        let currentType = 'expense';
        let currentTab = 'dashboard';
        let selectedMonth = '';
        let selectedColor = COLOR_PALETTE[0];
        let modalCategoryType = 'expense';

        // GAS Settings
        let gasSettings = { enabled: false, url: '' };

        // Initialization
        window.onload = function() {
            const today = new Date();
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            selectedMonth = `${year}-${month}`;
            document.getElementById('month-picker').value = selectedMonth;
            document.getElementById('input-date').value = today.toISOString().split('T')[0];

            document.getElementById('month-picker').addEventListener('change', (e) => {
                selectedMonth = e.target.value;
                updateApp();
            });

            loadCategories();
            loadGasSettings();
            loadData();
            updateCategoryOptions();
            updateApp();

            lucide.createIcons();
        };

        // Category LocalStorage Handlers
        function loadCategories() {
            const saved = localStorage.getItem('kakeibo_custom_categories');
            if (saved) {
                categories = JSON.parse(saved);
            }
        }

        function saveCategories() {
            localStorage.setItem('kakeibo_custom_categories', JSON.stringify(categories));
            updateCategoryOptions();
            updateApp();
        }

        function resetCategoriesToDefault() {
            if (confirm('カテゴリのカスタマイズ設定を初期化しますか？')) {
                categories = JSON.parse(JSON.stringify(DEFAULT_CATEGORIES));
                saveCategories();
                showToast('カテゴリを初期状態に戻しました');
            }
        }

        // Category Modal Logic
        function openCategoryModal(type) {
            modalCategoryType = type;
            document.getElementById('category-modal-title').textContent = type === 'expense' ? '支出カテゴリ管理' : '収入カテゴリ管理';
            renderColorPalette();
            renderCategoryManageList();
            cancelCategoryEdit();
            document.getElementById('category-modal').classList.remove('hidden');
        }

        function closeCategoryModal() {
            document.getElementById('category-modal').classList.add('hidden');
        }

        function renderColorPalette() {
            const container = document.getElementById('color-palette');
            container.innerHTML = '';
            COLOR_PALETTE.forEach(color => {
                const isSelected = color === selectedColor;
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `w-6 h-6 rounded-full ${color} flex items-center justify-center transition-transform ${isSelected ? 'ring-2 ring-indigo-600 scale-110' : 'opacity-80 hover:opacity-100'}`;
                if (isSelected) btn.innerHTML = `<i data-lucide="check" class="w-3.5 h-3.5 text-white"></i>`;
                btn.onclick = () => {
                    selectedColor = color;
                    renderColorPalette();
                };
                container.appendChild(btn);
            });
            lucide.createIcons();
        }

        function renderCategoryManageList() {
            const container = document.getElementById('category-manage-list');
            container.innerHTML = '';

            const list = categories[modalCategoryType] || [];
            list.forEach(cat => {
                const itemHtml = `
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 border border-slate-200/60 rounded-xl">
                        <div class="flex items-center space-x-2.5">
                            <span class="w-8 h-8 rounded-lg ${cat.color} text-white flex items-center justify-center text-sm shadow-xs">
                                ${cat.emoji || '🏷️'}
                            </span>
                            <span class="text-xs font-bold text-slate-700">${cat.name}</span>
                        </div>
                        <div class="flex items-center space-x-1">
                            <button onclick="editCategory('${cat.id}')" class="p-1.5 text-slate-400 hover:text-indigo-600 rounded-lg">
                                <i data-lucide="edit-2" class="w-4 h-4"></i>
                            </button>
                            <button onclick="deleteCategory('${cat.id}')" class="p-1.5 text-slate-400 hover:text-rose-500 rounded-lg">
                                <i data-lucide="trash" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', itemHtml);
            });
            lucide.createIcons();
        }

        function saveCategory() {
            const name = document.getElementById('cat-name-input').value.trim();
            const emoji = document.getElementById('cat-emoji-input').value.trim() || '🏷️';
            const editId = document.getElementById('edit-cat-id').value;

            if (!name) {
                showToast('カテゴリ名を入力してください');
                return;
            }

            if (editId) {
                // Update Existing
                const cat = categories[modalCategoryType].find(c => c.id === editId);
                if (cat) {
                    cat.name = name;
                    cat.emoji = emoji;
                    cat.color = selectedColor;
                }
                showToast('カテゴリを更新しました');
            } else {
                // Add New
                const newCat = {
                    id: 'cat_' + Date.now(),
                    name,
                    emoji,
                    color: selectedColor
                };
                categories[modalCategoryType].push(newCat);
                showToast('新規カテゴリを追加しました');
            }

            saveCategories();
            cancelCategoryEdit();
            renderCategoryManageList();
        }

        function editCategory(catId) {
            const cat = categories[modalCategoryType].find(c => c.id === catId);
            if (!cat) return;

            document.getElementById('edit-cat-id').value = cat.id;
            document.getElementById('cat-name-input').value = cat.name;
            document.getElementById('cat-emoji-input').value = cat.emoji || '🏷️';
            selectedColor = cat.color || COLOR_PALETTE[0];
            
            document.getElementById('cat-form-title').textContent = 'カテゴリを編集';
            document.getElementById('btn-save-cat').textContent = '更新する';
            document.getElementById('btn-cancel-cat').classList.remove('hidden');

            renderColorPalette();
        }

        function cancelCategoryEdit() {
            document.getElementById('edit-cat-id').value = '';
            document.getElementById('cat-name-input').value = '';
            document.getElementById('cat-emoji-input').value = '🏷️';
            document.getElementById('cat-form-title').textContent = '新しいカテゴリを追加';
            document.getElementById('btn-save-cat').textContent = '保存する';
            document.getElementById('btn-cancel-cat').classList.add('hidden');
            selectedColor = COLOR_PALETTE[0];
            renderColorPalette();
        }

        function deleteCategory(catId) {
            const list = categories[modalCategoryType];
            if (list.length <= 1) {
                showToast('最低1つのカテゴリが必要です');
                return;
            }

            if (confirm('このカテゴリを削除しますか？\n（すでに記録済みの該当データは「その他」カテゴリへ統合されます）')) {
                const fallbackCatId = modalCategoryType === 'expense' ? 'other_exp' : 'other_inc';
                
                // Re-assign transactions using this category to fallback
                transactions.forEach(t => {
                    if (t.type === modalCategoryType && t.category === catId) {
                        t.category = fallbackCatId;
                    }
                });
                saveData();

                categories[modalCategoryType] = list.filter(c => c.id !== catId);
                saveCategories();
                renderCategoryManageList();
                showToast('カテゴリを削除しました');
            }
        }

        // GAS Settings Handlers
        function loadGasSettings() {
            const saved = localStorage.getItem('kakeibo_gas_settings');
            if (saved) {
                gasSettings = JSON.parse(saved);
                document.getElementById('gas-toggle').checked = gasSettings.enabled;
                document.getElementById('gas-url-input').value = gasSettings.url || '';
            }
            updateGasStatusBadge();
        }

        function saveGasSettings() {
            const url = document.getElementById('gas-url-input').value.trim();
            gasSettings.url = url;
            localStorage.setItem('kakeibo_gas_settings', JSON.stringify(gasSettings));
            updateGasStatusBadge();
            showToast('GAS URL設定を保存しました');
        }

        function toggleGasIntegration() {
            gasSettings.enabled = document.getElementById('gas-toggle').checked;
            if (gasSettings.enabled && !gasSettings.url) {
                showToast('GASのWeb App URLを設定してください');
            }
            localStorage.setItem('kakeibo_gas_settings', JSON.stringify(gasSettings));
            updateGasStatusBadge();
        }

        function updateGasStatusBadge() {
            const badge = document.getElementById('gas-status-badge');
            const banner = document.getElementById('gas-sync-banner');

            if (gasSettings.enabled && gasSettings.url) {
                badge.className = "text-[10px] px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800 font-medium flex items-center gap-1";
                badge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> 連携中`;
                banner.classList.remove('hidden');
            } else {
                badge.className = "text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700 font-medium flex items-center gap-1";
                badge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span> 未連携`;
                banner.classList.add('hidden');
            }
        }

        // Data Storage Handlers
        function loadData() {
            const saved = localStorage.getItem('kakeibo_transactions');
            if (saved) {
                transactions = JSON.parse(saved);
            } else {
                loadDemoData(false);
            }
        }

        function saveData() {
            localStorage.setItem('kakeibo_transactions', JSON.stringify(transactions));
        }

        function loadDemoData(notify = true) {
            const today = new Date();
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            
            transactions = [
                { id: '1', type: 'income', category: 'salary', amount: 280000, date: `${year}-${month}-10`, note: '今月の給与' },
                { id: '2', type: 'expense', category: 'food', amount: 4500, date: `${year}-${month}-12`, note: 'スーパー買い物' },
                { id: '3', type: 'expense', category: 'transport', amount: 1200, date: `${year}-${month}-14`, note: '電車移動' },
                { id: '4', type: 'expense', category: 'housing', amount: 68000, date: `${year}-${month}-01`, note: '家賃支払い' }
            ];
            saveData();
            updateApp();
            if (notify) showToast('デモデータを読み込みました');
        }

        function clearAllData() {
            if (confirm('すべての収支記録を削除しますか？')) {
                transactions = [];
                saveData();
                updateApp();
                showToast('データを初期化しました');
            }
        }

        // Tab Switch
        function switchTab(tabId) {
            currentTab = tabId;
            document.querySelectorAll('.view-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(`view-${tabId}`).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-emerald-600');
                btn.classList.add('text-slate-400');
            });
            document.getElementById(`nav-${tabId}`).classList.remove('text-slate-400');
            document.getElementById(`nav-${tabId}`).classList.add('text-emerald-600');

            if (tabId === 'history') {
                populateCategoryFilterOptions();
                renderHistory();
            }
        }

        function setType(type) {
            currentType = type;
            const btnExpense = document.getElementById('btn-type-expense');
            const btnIncome = document.getElementById('btn-type-income');

            if (type === 'expense') {
                btnExpense.className = "py-2.5 text-xs font-bold rounded-lg transition-all bg-white text-rose-500 shadow-sm";
                btnIncome.className = "py-2.5 text-xs font-bold rounded-lg transition-all text-slate-500";
            } else {
                btnIncome.className = "py-2.5 text-xs font-bold rounded-lg transition-all bg-white text-emerald-600 shadow-sm";
                btnExpense.className = "py-2.5 text-xs font-bold rounded-lg transition-all text-slate-500";
            }

            updateCategoryOptions();
        }

        function updateCategoryOptions() {
            const select = document.getElementById('input-category');
            select.innerHTML = '';
            
            const list = categories[currentType] || [];
            list.forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat.id;
                opt.textContent = `${cat.emoji || ''} ${cat.name}`;
                select.appendChild(opt);
            });
        }

        // GAS Web App Push
        async function sendToGoogleSheets(data) {
            if (!gasSettings.enabled || !gasSettings.url) return;

            const categoryInfo = getCategoryInfo(data.type, data.category);
            const payload = {
                ...data,
                categoryName: categoryInfo.name
            };

            showToast('スプレッドシートへ送信中...');

            try {
                await fetch(gasSettings.url, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(payload)
                });
                showToast('スプレッドシートに追記しました！');
            } catch (error) {
                console.error('GAS Error:', error);
                showToast('スプレッドシート送信エラー');
            }
        }

        // Form Submit
        async function handleFormSubmit(e) {
            e.preventDefault();

            const date = document.getElementById('input-date').value;
            const category = document.getElementById('input-category').value;
            const amount = parseInt(document.getElementById('input-amount').value, 10);
            const note = document.getElementById('input-note').value.trim();

            if (!amount || amount <= 0) {
                showToast('正しい金額を入力してください');
                return;
            }

            const newTransaction = {
                id: Date.now().toString(),
                type: currentType,
                category,
                amount,
                date,
                note
            };

            transactions.unshift(newTransaction);
            saveData();

            document.getElementById('input-amount').value = '';
            document.getElementById('input-note').value = '';

            updateApp();
            
            if (gasSettings.enabled && gasSettings.url) {
                await sendToGoogleSheets(newTransaction);
            } else {
                showToast('記録を保存しました');
            }

            switchTab('dashboard');
        }

        function deleteTransaction(id) {
            transactions = transactions.filter(t => t.id !== id);
            saveData();
            updateApp();
            renderHistory();
            showToast('記録を削除しました');
        }

        // Dashboard Rendering
        function updateApp() {
            const filtered = transactions.filter(t => t.date.startsWith(selectedMonth));

            let totalInc = 0;
            let totalExp = 0;
            const catTotals = {};

            filtered.forEach(t => {
                if (t.type === 'income') {
                    totalInc += t.amount;
                } else {
                    totalExp += t.amount;
                    catTotals[t.category] = (catTotals[t.category] || 0) + t.amount;
                }
            });

            const net = totalInc - totalExp;

            document.getElementById('total-income').textContent = `¥${totalInc.toLocaleString()}`;
            document.getElementById('total-expense').textContent = `¥${totalExp.toLocaleString()}`;
            document.getElementById('net-balance').textContent = `¥${net.toLocaleString()}`;

            renderCategoryBars(catTotals, totalExp);
            renderRecentTransactions(filtered.slice(0, 4));

            lucide.createIcons();
        }

        function getCategoryInfo(type, catId) {
            const list = categories[type] || [];
            return list.find(c => c.id === catId) || { name: 'その他', emoji: '💡', color: 'bg-slate-400' };
        }

        function renderCategoryBars(catTotals, totalExp) {
            const container = document.getElementById('category-bars');
            const noData = document.getElementById('no-category-data');
            container.innerHTML = '';

            const categoriesWithSpend = Object.keys(catTotals).map(catId => {
                const info = getCategoryInfo('expense', catId);
                return {
                    id: catId,
                    name: info.name,
                    emoji: info.emoji || '🏷️',
                    amount: catTotals[catId],
                    color: info.color || 'bg-slate-500',
                    percentage: totalExp > 0 ? Math.round((catTotals[catId] / totalExp) * 100) : 0
                };
            }).sort((a, b) => b.amount - a.amount);

            if (categoriesWithSpend.length === 0) {
                noData.classList.remove('hidden');
                return;
            }
            noData.classList.add('hidden');

            categoriesWithSpend.forEach(cat => {
                const barHtml = `
                    <div class="space-y-1">
                        <div class="flex justify-between items-center text-xs">
                            <span class="font-medium text-slate-700 flex items-center gap-1">
                                <span>${cat.emoji}</span>
                                <span>${cat.name}</span>
                                <span class="text-slate-400 font-normal text-[10px]">(${cat.percentage}%)</span>
                            </span>
                            <span class="font-semibold text-slate-800">¥${cat.amount.toLocaleString()}</span>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                            <div class="${cat.color} h-2 rounded-full transition-all duration-500" style="width: ${cat.percentage}%"></div>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', barHtml);
            });
        }

        function renderRecentTransactions(list) {
            const container = document.getElementById('recent-list');
            container.innerHTML = '';

            if (list.length === 0) {
                container.innerHTML = `<div class="text-center py-4 text-xs text-slate-400">データがありません</div>`;
                return;
            }

            list.forEach(t => {
                const info = getCategoryInfo(t.type, t.category);
                const isExpense = t.type === 'expense';
                const itemHtml = `
                    <div class="py-2.5 flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 rounded-xl ${info.color} text-white flex items-center justify-center text-xs shadow-xs">
                                ${info.emoji || '🏷️'}
                            </div>
                            <div>
                                <p class="text-xs font-semibold text-slate-800">${info.name}</p>
                                <p class="text-[10px] text-slate-400">${t.date} ${t.note ? '• ' + t.note : ''}</p>
                            </div>
                        </div>
                        <span class="text-xs font-bold ${isExpense ? 'text-rose-500' : 'text-emerald-600'}">
                            ${isExpense ? '-' : '+'}¥${t.amount.toLocaleString()}
                        </span>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', itemHtml);
            });
        }

        function populateCategoryFilterOptions() {
            const select = document.getElementById('history-filter-category');
            select.innerHTML = '<option value="all">すべてのカテゴリ</option>';
            
            [...categories.expense, ...categories.income].forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat.id;
                opt.textContent = `${cat.emoji || ''} ${cat.name}`;
                select.appendChild(opt);
            });
        }

        function renderHistory() {
            const container = document.getElementById('full-history-list');
            const catFilter = document.getElementById('history-filter-category').value;
            const typeFilter = document.getElementById('history-filter-type').value;

            let list = transactions.filter(t => t.date.startsWith(selectedMonth));
            if (catFilter !== 'all') list = list.filter(t => t.category === catFilter);
            if (typeFilter !== 'all') list = list.filter(t => t.type === typeFilter);

            container.innerHTML = '';

            if (list.length === 0) {
                container.innerHTML = `<div class="text-center py-8 text-xs text-slate-400">該当する条件の履歴がありません</div>`;
                return;
            }

            list.forEach(t => {
                const info = getCategoryInfo(t.type, t.category);
                const isExpense = t.type === 'expense';
                const itemHtml = `
                    <div class="p-3 flex items-center justify-between hover:bg-slate-50 transition-colors">
                        <div class="flex items-center space-x-3">
                            <div class="w-9 h-9 rounded-xl ${info.color} text-white flex items-center justify-center text-xs flex-shrink-0 shadow-xs">
                                ${info.emoji || '🏷️'}
                            </div>
                            <div class="truncate">
                                <div class="flex items-center space-x-1.5">
                                    <span class="text-xs font-semibold text-slate-800">${info.name}</span>
                                    <span class="text-[10px] text-slate-400 font-normal">${t.date}</span>
                                </div>
                                ${t.note ? `<p class="text-[11px] text-slate-500 truncate mt-0.5">${t.note}</p>` : ''}
                            </div>
                        </div>
                        <div class="flex items-center space-x-2 pl-2">
                            <span class="text-xs font-bold whitespace-nowrap ${isExpense ? 'text-rose-500' : 'text-emerald-600'}">
                                ${isExpense ? '-' : '+'}¥${t.amount.toLocaleString()}
                            </span>
                            <button onclick="deleteTransaction('${t.id}')" class="text-slate-300 hover:text-rose-500 p-1 rounded-lg transition-colors">
                                <i data-lucide="trash" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', itemHtml);
            });

            lucide.createIcons();
        }

        // Modal Control
        function openGasGuideModal() {
            document.getElementById('gas-guide-modal').classList.remove('hidden');
        }

        function closeGasGuideModal() {
            document.getElementById('gas-guide-modal').classList.add('hidden');
        }

        function copyGasCode() {
            const codeText = document.getElementById('gas-code-text').textContent;
            const textarea = document.createElement('textarea');
            textarea.value = codeText;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            showToast('GASコードをクリップボードにコピーしました');
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            toastMsg.textContent = message;
            
            toast.classList.remove('opacity-0', 'pointer-events-none');
            toast.classList.add('opacity-100');

            setTimeout(() => {
                toast.classList.remove('opacity-100');
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2500);
        }
    </script>
</body>
</html>
